set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY de10_lite_top
set_global_assignment -name VERILOG_FILE de10_lite_top.v
set_global_assignment -name VERILOG_FILE ../rtl/soc/riscv_core.v
set_global_assignment -name VERILOG_FILE ../rtl/soc/imem.v
set_global_assignment -name VERILOG_FILE ../rtl/soc/dmem.v
set_global_assignment -name VERILOG_FILE ../rtl/soc/riscv_soc.v
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/mac_array_4x4.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/npu_peripheral.sv

# Board/device reference:
# https://www.terasic.com.tw/cgi-bin/page/archive.pl?Language=English&CategoryNo=218&No=1021
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_location_assignment PIN_B8 -to KEY[0]
set_location_assignment PIN_A8 -to LEDR[0]
set_location_assignment PIN_A9 -to LEDR[1]
set_location_assignment PIN_A10 -to LEDR[2]
set_location_assignment PIN_B10 -to LEDR[3]
set_location_assignment PIN_C9 -to LEDR[4]
set_location_assignment PIN_C10 -to LEDR[5]
set_location_assignment PIN_D8 -to LEDR[6]
set_location_assignment PIN_D9 -to LEDR[7]
set_location_assignment PIN_E7 -to LEDR[8]
set_location_assignment PIN_E8 -to LEDR[9]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]
